# Koneksi PostgreSQL.
# Lokal dengan Docker  : postgresql://postgres:postgres@localhost:5432/kasir_poci
# Neon / Supabase      : salin "connection string" dari dashboard (pakai yang pooled untuk Vercel)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kasir_poci

# Kunci rahasia untuk menandatangani sesi login, minimal 32 karakter.
# Buat yang acak dengan: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-teks-acak-minimal-32-karakter

# Akun pemilik pertama yang dibuat oleh `npm run db:seed` (PIN 4–6 angka).
# Karyawan ditambahkan nanti dari halaman Admin → Pengaturan.
OWNER_NAME=Pemilik
OWNER_PIN=123456
